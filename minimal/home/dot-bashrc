if [[ -z $DISPLAY ]] && [[ $(tty) = /dev/tty1 ]]; then
		exec startx &>/dev/null 
fi

source ~/.aliases
export GOPATH=~/go
export PATH=$GOPATH/bin:/usr/local/bin:/sbin:/usr/sbin:$PATH
export MANPATH=${MANPATH:-}:$HOME/.local/share/man
export PF_INFO="ascii os host kernel uptime pkgs shell wm memory"
export EDITOR="vim"
export PODMAN_IGNORE_CGROUPSV1_WARNING=true

# Load git completion
if [ -f /usr/share/bash-completion/completions/git ]; then
    source /usr/share/bash-completion/completions/git
elif [ -f /etc/bash_completion.d/git ]; then
    source /etc/bash_completion.d/git
fi

# Color definitions for bash (wrapped in \[ \] for prompt)
RED='\[\033[0;31m\]'
GREEN='\[\033[0;32m\]'
BLUE='\[\033[0;34m\]'
CYAN='\[\033[0;36m\]'
BOLD='\[\033[1m\]'
RESET='\[\033[0m\]'

# Show only the last 3 folders of the current path (bash does this itself)
PROMPT_DIRTRIM=3

# Git info for prompt: branch name, plus (unstaged) / (staged) markers.
# `git diff --quiet` only asks "is there any change?" and stops at the first
# one it finds, which is much cheaper than listing every file with
# `git status` on every prompt. Untracked files are not shown (same as before).
function parse_git_info() {
    local ref
    ref=$(git symbolic-ref --short HEAD 2>/dev/null)
    [[ -z "$ref" ]] && return

    local git_str="$GREEN $ref$RESET"

    # changes in tracked files that are not staged yet
    git diff --quiet 2>/dev/null || git_str+=" $RED(unstaged)$RESET"
    # changes that are staged for the next commit
    git diff --cached --quiet 2>/dev/null || git_str+=" $GREEN(staged)$RESET"

    echo " $git_str"
}

function set_bash_prompt() {
    local exit_code=$?
    local symbol user dir git_info
    
    if [ $exit_code -eq 0 ]; then
        symbol="$BLUE$RESET"
    else
        symbol="$RED$RESET"
    fi
    
    user="$RED\u$RESET"
    dir="$BOLD$CYAN\w$RESET"
    git_info=$(parse_git_info)
    
    PS1="$symbol $user $dir$git_info "
}

PROMPT_COMMAND=set_bash_prompt

# Bind CTRL-F to fzf
if command -v fzf &>/dev/null; then
    bind '"\C-f": "fzf\C-m"'
fi

# only load it if it exists, so new machines without it show no error
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"
