#! /bin/sh

pgrep -x sxhkd > /dev/null || sxhkd &

~/.config/polybar/launch.sh &
# set the wallpaper: fill the whole screen, cropping the picture if its shape
# does not match. To fit the whole picture with black bars use --bg-max instead
feh --bg-fill ~/.config/backgrounds/forest.jpg &
xsetroot -cursor_name left_ptr &
picom &
# lock the screen (i3lock) when the session gets locked, e.g. by the
# "Lock" entry of the power menu; without this nothing would lock
xss-lock --transfer-sleep-lock -- i3lock --nofork --color=232a2e &

# 3 desktops: sxhkd has keys for desktops 1-3 (super + 1..3)
bspc monitor -d 1 2 3

bspc config border_width         3
bspc config window_gap          35

bspc config split_ratio          0.50
bspc config borderless_monocle   true
bspc config gapless_monocle      true
bspc config focus_follows_pointer true
